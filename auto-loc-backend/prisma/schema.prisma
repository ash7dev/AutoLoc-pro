generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id          String       @id @default(uuid())
  userId      String       @unique @map("user_id")
  email       String?      @unique
  phone       String?      @unique
  createdAt   DateTime     @default(now()) @map("created_at")
  role        RoleProfile  @default(LOCATAIRE)
  utilisateur Utilisateur?

  @@index([userId])
  @@map("profiles")
}

model Utilisateur {
  id                       String             @id @default(uuid())
  email                    String             @unique
  telephone                String             @unique
  prenom                   String
  nom                      String
  avatarUrl                String?
  avatarPublicId           String?
  dateNaissance            DateTime?
  statutKyc                StatutKyc          @default(NON_VERIFIE)
  actif                    Boolean            @default(true)
  bloqueJusqua             DateTime?
  noteLocataire            Decimal            @default(0) @db.Decimal(3, 2)
  noteProprietaire         Decimal            @default(0) @db.Decimal(3, 2)
  totalAvis                Int                @default(0)
  creeLe                   DateTime           @default(now())
  misAJourLe               DateTime           @updatedAt
  userId                   String             @unique
  phoneVerified            Boolean            @default(false)
  profileCompleted         Boolean            @default(false)
  kycDocumentUrl           String?
  kycDocumentBackUrl       String?
  kycSelfieUrl             String?
  kycRejectionReason       String?
  permisPublicId           String?
  permisUrl                String?
  avisEnvoyes              Avis[]                   @relation("auteur")
  avisRecus                Avis[]                   @relation("cible")
  reservationsLocataire    Reservation[]            @relation("locataire")
  reservationsProprietaire Reservation[]            @relation("proprietaire_res")
  profile                  Profile                  @relation(fields: [userId], references: [userId])
  vehicules                Vehicule[]
  wallet                   Wallet?
  pushSubscriptions        PushSubscription[]
  penalites                PenaliteProprietaire[]

  @@index([userId])
}

model Vehicule {
  id                         String                    @id @default(uuid())
  proprietaireId             String
  marque                     String
  modele                     String
  annee                      Int
  type                       TypeVehicule
  carburant                  Carburant?
  transmission               Transmission?
  nombrePlaces               Int?
  immatriculation            String                    @unique
  prixParJour                Decimal                   @db.Decimal(10, 2)
  ville                      String
  adresse                    String
  latitude                   Decimal?                  @db.Decimal(10, 7)
  longitude                  Decimal?                  @db.Decimal(10, 7)
  joursMinimum               Int                       @default(1)
  ageMinimum                 Int                       @default(18)
  statut                     StatutVehicule            @default(EN_ATTENTE_VALIDATION)
  note                       Decimal                   @default(0) @db.Decimal(3, 2)
  totalAvis                  Int                       @default(0)
  totalLocations             Int                       @default(0)
  creeLe                     DateTime                  @default(now())
  misAJourLe                 DateTime                  @updatedAt
  assurance                  String?
  reglesSpecifiques          String?
  zoneConduite               String?
  assuranceDocPublicId       String?
  assuranceDocUrl            String?
  carteGrisePublicId         String?
  carteGriseUrl              String?
  fraisLivraison             Decimal?                  @db.Decimal(10, 2)
  autoriseHorsDakar          Boolean                   @default(false)
  supplementHorsDakarParJour Decimal?                  @db.Decimal(10, 2)
  carburantCondition         String?
  archiveLe                  DateTime?
  isFeatured                 Boolean                   @default(false)
  featuredUntil              DateTime?
  indisponibilites           IndisponibiliteVehicule[]
  photos                     PhotoVehicule[]
  reservations               Reservation[]
  tarifsProgressifs          TarifTier[]
  proprietaire               Utilisateur               @relation(fields: [proprietaireId], references: [id])
  equipements                VehiculeEquipement[]
  views                      VehiculeView[]
  clicks                     VehiculeClick[]
  metrics                    VehiculeMetrics?

  @@index([proprietaireId])
  @@index([statut])
  @@index([ville])
  @@index([statut, ville, prixParJour])
  @@index([ville, type])
  @@index([isFeatured])
  @@index([statut, totalLocations(sort: Desc), note(sort: Desc), creeLe(sort: Desc)])
  @@index([statut, creeLe(sort: Desc)])
  // 🚀 OPTIMISATIONS PERFORMANCE - Semaine 1
  @@index([statut, ville, type, prixParJour]) // Recherche multi-critères optimisée
  @@index([statut, note(sort: Desc), totalAvis(sort: Desc)]) // Tri par qualité
  @@index([isFeatured, featuredUntil, statut]) // Featured vehicles actifs
  @@index([ville, statut, note(sort: Desc)]) // Recherche ville avec tri note
  @@index([archiveLe, statut]) // Cleanup des archivés
  @@index([statut, ville, creeLe(sort: Desc)]) // Nouveautés par ville
}

model TarifTier {
  id         String   @id @default(uuid())
  vehiculeId String
  joursMin   Int
  joursMax   Int?
  prix       Decimal  @db.Decimal(10, 2)
  position   Int      @default(0)
  vehicule   Vehicule @relation(fields: [vehiculeId], references: [id], onDelete: Cascade)

  @@index([vehiculeId])
}

model Equipement {
  id        String               @id @default(uuid())
  nom       String               @unique
  vehicules VehiculeEquipement[]
}

model VehiculeEquipement {
  vehiculeId   String
  equipementId String
  equipement   Equipement @relation(fields: [equipementId], references: [id], onDelete: Cascade)
  vehicule     Vehicule   @relation(fields: [vehiculeId], references: [id], onDelete: Cascade)

  @@id([vehiculeId, equipementId])
}

model PhotoVehicule {
  id            String   @id @default(uuid())
  vehiculeId    String
  url           String
  position      Int      @default(0)
  estPrincipale Boolean  @default(false)
  creeLe        DateTime @default(now())
  publicId      String?
  vehicule      Vehicule @relation(fields: [vehiculeId], references: [id], onDelete: Cascade)

  @@index([vehiculeId])
  @@index([vehiculeId, estPrincipale])
}

model Reservation {
  id                     String                  @id @default(uuid())
  vehiculeId             String
  locataireId            String
  proprietaireId         String
  dateDebut              DateTime
  dateFin                DateTime
  prixParJour            Decimal                 @db.Decimal(10, 2)
  totalBase              Decimal                 @db.Decimal(10, 2)
  tauxCommission         Decimal                 @db.Decimal(5, 4)
  montantCommission      Decimal                 @db.Decimal(10, 2)
  totalLocataire         Decimal                 @db.Decimal(10, 2)
  netProprietaire        Decimal                 @db.Decimal(10, 2)
  statut                 StatutReservation       @default(EN_ATTENTE_PAIEMENT)
  paymentUrl             String?
  delaiSignature         DateTime
  annuleParId            String?
  annuleLe               DateTime?
  raisonAnnulation       String?
  confirmeeLe            DateTime?
  checkinLe              DateTime?
  checkoutLe             DateTime?
  closeLe                DateTime?
  updatedBySystem        Boolean                 @default(false)
  creeLe                 DateTime                @default(now())
  misAJourLe             DateTime                @updatedAt
  contratPublicId        String?
  contratUrl             String?
  checkinLocataireLe     DateTime?
  checkinProprietaireLe  DateTime?
  adresseLivraison       String?
  fraisLivraison         Decimal?                @db.Decimal(10, 2)
  horsDakar              Boolean                 @default(false)
  supplementHorsDakar    Decimal?                @db.Decimal(10, 2)
  tacitCheckinDeadlineLe DateTime?
  checkinLocataireSource CheckinLocataireSource?
  absenceSignalee        Boolean                 @default(false)
  occupantsSignales      Boolean                 @default(false)
  walletCredite          Boolean                 @default(false)
  avis                   Avis[]
  idempotencyKey         IdempotencyKey?
  litige                 Litige?
  paiement               Paiement?
  photosEtatLieu         PhotoEtatLieu[]
  locataire              Utilisateur             @relation("locataire", fields: [locataireId], references: [id])
  proprietaire           Utilisateur             @relation("proprietaire_res", fields: [proprietaireId], references: [id])
  vehicule               Vehicule                @relation(fields: [vehiculeId], references: [id])
  historique             ReservationHistorique[]
  penalites              PenaliteProprietaire[]

  @@index([vehiculeId, statut])
  @@index([vehiculeId, statut, dateDebut, dateFin])
  @@index([locataireId])
  @@index([locataireId, creeLe(sort: Desc)])
  @@index([locataireId, statut, creeLe(sort: Desc)])
  @@index([proprietaireId])
  @@index([proprietaireId, statut])
  @@index([proprietaireId, creeLe(sort: Desc)])
  @@index([proprietaireId, statut, creeLe(sort: Desc)])
  @@index([statut])
  @@index([delaiSignature, statut])
  @@index([statut, tacitCheckinDeadlineLe])
}

model ReservationHistorique {
  id            String             @id @default(uuid())
  reservationId String
  ancienStatut  StatutReservation?
  nouveauStatut StatutReservation
  modifiePar    String?
  modifieLe     DateTime           @default(now())
  reservation   Reservation        @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([reservationId])
}

model Paiement {
  id                       String              @id @default(uuid())
  reservationId            String              @unique
  montant                  Decimal             @db.Decimal(10, 2)
  devise                   Devise              @default(XOF)
  fournisseur              FournisseurPaiement
  idTransactionFournisseur String?             @unique
  statut                   StatutPaiement      @default(EN_ATTENTE)
  telephonePaiement        String?             // Numéro de téléphone utilisé pour le paiement (pour remboursements)
  creeLe                   DateTime            @default(now())
  rembourseLe              DateTime?
  montantRembourse         Decimal?            @db.Decimal(10, 2)
  reservation              Reservation         @relation(fields: [reservationId], references: [id])

  @@index([statut])
  @@index([fournisseur, statut]) // Requêtes par provider
  @@index([idTransactionFournisseur, fournisseur]) // Webhook lookup rapide
  @@index([creeLe(sort: Desc), statut]) // Liste chronologique des paiements
}

model Wallet {
  id              String              @id @default(uuid())
  utilisateurId   String              @unique
  soldeDisponible Decimal             @default(0) @db.Decimal(10, 2)
  creeLe          DateTime            @default(now())
  misAJourLe      DateTime            @updatedAt
  retraits        Retrait[]
  transactions    TransactionWallet[]
  utilisateur     Utilisateur         @relation(fields: [utilisateurId], references: [id])

  @@index([utilisateurId])
}

model TransactionWallet {
  id                 String                @id @default(uuid())
  walletId           String
  reservationId      String?
  type               TypeTransactionWallet
  montant            Decimal               @db.Decimal(10, 2)
  sens               SensTransaction
  soldeApres         Decimal               @db.Decimal(10, 2)
  fournisseur        FournisseurPaiement?  // Wave, Orange Money, etc. (pour tracer l'origine)
  creeLe             DateTime              @default(now())
  wallet             Wallet                @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@unique([reservationId, type])
  @@index([walletId])
  @@index([walletId, creeLe(sort: Desc)])
  @@index([walletId, fournisseur])
}

model Retrait {
  id                        String         @id @default(uuid())
  walletId                  String
  montant                   Decimal        @db.Decimal(10, 2)
  methode                   MethodeRetrait
  destinataire              String
  statut                    StatutRetrait  @default(EN_ATTENTE)
  raisonRejet               String?
  idTransactionFournisseur  String?        // ID de transaction Wave/Orange Money pour le payout
  demandeeLe                DateTime       @default(now())
  traiteLe                  DateTime?
  wallet                    Wallet         @relation(fields: [walletId], references: [id])

  @@index([statut])
}

model PenaliteProprietaire {
  id            String      @id @default(uuid())
  utilisateurId String
  reservationId String
  montant       Decimal     @db.Decimal(10, 2)
  raison        String
  creeLe        DateTime    @default(now())
  preleveleLe   DateTime?
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id])
  reservation   Reservation @relation(fields: [reservationId], references: [id])

  @@index([utilisateurId, preleveleLe])
  @@index([utilisateurId])
}

model Litige {
  id                  String       @id @default(uuid())
  reservationId       String       @unique
  motif               String       // Motif du litige (ex: DEPASSEMENT_PERSONNES, DEGRADATION, etc.)
  description         String
  coutEstime          Decimal?     @db.Decimal(10, 2)
  statut              StatutLitige @default(EN_ATTENTE)
  montantCompensation Decimal?     @db.Decimal(10, 2)
  creeLe              DateTime     @default(now())
  resoluLe            DateTime?
  resoluParAdminId    String?
  reservation         Reservation  @relation(fields: [reservationId], references: [id])

  @@index([statut])
}

model Avis {
  id            String      @id @default(uuid())
  reservationId String
  auteurId      String
  cibleId       String
  note          Int
  commentaire   String?
  typeAvis      TypeAvis
  creeLe        DateTime    @default(now())
  auteur        Utilisateur @relation("auteur", fields: [auteurId], references: [id])
  cible         Utilisateur @relation("cible", fields: [cibleId], references: [id])
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@unique([reservationId, auteurId])
  @@index([cibleId])
}

model IdempotencyKey {
  id            String      @id @default(uuid())
  key           String      @unique
  reservationId String      @unique
  expiresAt     DateTime
  creeLe        DateTime    @default(now())
  paymentRef    String?
  paymentUrl    String?
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model WebhookLog {
  id                       String              @id @default(uuid())
  provider                 FournisseurPaiement
  payloadRaw               String
  signatureReceived        String
  signatureCalculated      String
  isValid                  Boolean
  statusCode               Int?
  errorMessage             String?
  durationMs               Int?
  idTransactionFournisseur String?
  reservationId            String?
  creeLe                   DateTime            @default(now())

  @@index([provider, creeLe])
  @@index([idTransactionFournisseur])
  @@index([reservationId])
}

model PhotoEtatLieu {
  id            String          @id @default(uuid())
  reservationId String
  type          TypeEtatLieu
  url           String
  publicId      String?
  categorie     CategoriePhoto?
  position      Int             @default(0)
  creeLe        DateTime        @default(now())
  reservation   Reservation     @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([reservationId, type])
}

model IndisponibiliteVehicule {
  id         String   @id @default(uuid())
  vehiculeId String
  dateDebut  DateTime @db.Date
  dateFin    DateTime @db.Date
  motif      String?
  creeLe     DateTime @default(now())
  vehicule   Vehicule @relation(fields: [vehiculeId], references: [id], onDelete: Cascade)

  @@index([vehiculeId, dateDebut, dateFin])
}

model PushSubscription {
  id          String      @id @default(uuid())
  userId      String
  endpoint    String      @unique
  p256dh      String
  auth        String
  userAgent   String?
  deviceType  String?
  creeLe      DateTime    @default(now()) @map("created_at")
  misAJourLe  DateTime    @updatedAt @map("updated_at")
  utilisateur Utilisateur @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

enum RoleProfile {
  LOCATAIRE
  PROPRIETAIRE
  ADMIN
  SUPPORT
}

enum StatutKyc {
  NON_VERIFIE
  EN_ATTENTE
  VERIFIE
  REJETE
}

enum TypeVehicule {
  BERLINE
  SUV
  PICKUP
  MINIVAN
  UTILITAIRE
  CITADINE
  MONOSPACE
  MINIBUS
  LUXE
  FOUR_X_FOUR
}

enum StatutVehicule {
  EN_ATTENTE_VALIDATION
  VERIFIE
  SUSPENDU
  ARCHIVE
  BROUILLON
}

enum Carburant {
  ESSENCE
  DIESEL
  HYBRIDE
  ELECTRIQUE
}

enum Transmission {
  MANUELLE
  AUTOMATIQUE
}

enum CheckinLocataireSource {
  USER
  SYSTEM_TACIT
}

enum StatutReservation {
  INITIEE
  EN_ATTENTE_PAIEMENT
  PAYEE
  CONFIRMEE
  EN_COURS
  TERMINEE
  ANNULEE
  LITIGE
}

enum Devise {
  XOF
  EUR
  USD
}

enum FournisseurPaiement {
  WAVE
  ORANGE_MONEY
  STRIPE
}

enum StatutPaiement {
  EN_ATTENTE
  CONFIRME
  ECHOUE
  REMBOURSE
  EN_ATTENTE_REMBOURSEMENT
}

enum TypeTransactionWallet {
  CREDIT_LOCATION
  DEBIT_PENALITE
  DEBIT_RETRAIT
}

enum SensTransaction {
  CREDIT
  DEBIT
}

enum MethodeRetrait {
  WAVE
  ORANGE_MONEY
}

enum StatutRetrait {
  EN_ATTENTE
  VALIDE
  EFFECTUE
  REJETE
}

enum StatutLitige {
  EN_ATTENTE
  FONDE
  NON_FONDE
}

enum TypeAvis {
  LOCATAIRE_NOTE_PROPRIO
  PROPRIO_NOTE_LOCATAIRE
}

enum TypeEtatLieu {
  CHECKIN
  CHECKOUT
}

enum CategoriePhoto {
  AVANT
  ARRIERE
  COTE_GAUCHE
  COTE_DROIT
  INTERIEUR
  COMPTEUR_KM
  CARBURANT
  AUTRE
}

// ═══════════════════════════════════════════════════════════════════
// 🚀 SYSTÈME DE TRACKING & ANALYTICS (Optimisation Feed)
// ═══════════════════════════════════════════════════════════════════

/// Track les vues de véhicules pour calculer le taux d'engagement
model VehiculeView {
  id           String    @id @default(uuid())
  vehiculeId   String
  userId       String?   // null si utilisateur non authentifié
  sessionId    String?   // Pour tracker les utilisateurs anonymes
  source       String?   // "feed_premium", "feed_nouveautes", "feed_recommended", "search", "direct"
  ville        String?   // Ville de recherche de l'utilisateur
  creeLe       DateTime  @default(now())
  vehicule     Vehicule  @relation(fields: [vehiculeId], references: [id], onDelete: Cascade)

  @@index([vehiculeId, creeLe(sort: Desc)])
  @@index([userId, creeLe(sort: Desc)])
  @@index([sessionId, creeLe(sort: Desc)])
  @@index([source])
  @@map("vehicule_views")
}

/// Track les clics sur les véhicules pour mesurer l'engagement
model VehiculeClick {
  id           String    @id @default(uuid())
  vehiculeId   String
  userId       String?
  sessionId    String?
  source       String?   // Provenance du clic
  actionType   String    // "view_detail", "start_booking", "call_owner", etc.
  creeLe       DateTime  @default(now())
  vehicule     Vehicule  @relation(fields: [vehiculeId], references: [id], onDelete: Cascade)

  @@index([vehiculeId, creeLe(sort: Desc)])
  @@index([userId, creeLe(sort: Desc)])
  @@index([actionType])
  @@map("vehicule_clicks")
}

/// Historique de recherche utilisateur pour personnalisation
model SearchHistory {
  id             String    @id @default(uuid())
  userId         String?
  sessionId      String?
  ville          String?
  type           TypeVehicule?
  prixMin        Decimal?  @db.Decimal(10, 2)
  prixMax        Decimal?  @db.Decimal(10, 2)
  dateDebut      DateTime?
  dateFin        DateTime?
  transmission   Transmission?
  carburant      Carburant?
  placesMin      Int?
  equipements    String[]  // Array des équipements recherchés
  resultCount    Int       @default(0)
  creeLe         DateTime  @default(now())

  @@index([userId, creeLe(sort: Desc)])
  @@index([sessionId, creeLe(sort: Desc)])
  @@index([ville, creeLe(sort: Desc)])
  @@map("search_history")
}

/// Métriques précalculées pour chaque véhicule (refresh quotidien via cron)
model VehiculeMetrics {
  id                    String    @id @default(uuid())
  vehiculeId            String    @unique
  vues30j               Int       @default(0) // Vues derniers 30 jours
  clics30j              Int       @default(0) // Clics derniers 30 jours
  tauxEngagement        Decimal   @default(0) @db.Decimal(5, 4) // clics / vues
  scorePopularite       Decimal   @default(0) @db.Decimal(10, 4) // Score composite
  scoreQualite          Decimal   @default(0) @db.Decimal(10, 4) // Basé sur note + avis
  scoreFraicheur        Decimal   @default(0) @db.Decimal(10, 4) // Basé sur date création
  scoreGlobal           Decimal   @default(0) @db.Decimal(10, 4) // Score final pondéré
  derniereMiseAJour     DateTime  @default(now())
  vehicule              Vehicule  @relation(fields: [vehiculeId], references: [id], onDelete: Cascade)

  @@index([scoreGlobal(sort: Desc)])
  @@index([scorePopularite(sort: Desc)])
  @@index([vehiculeId])
  @@map("vehicule_metrics")
}

/// Préférences utilisateur déduites de l'historique
model UserPreferences {
  id                    String          @id @default(uuid())
  userId                String          @unique
  villesPreferes        String[]        // Villes les plus recherchées
  typesPreferes         TypeVehicule[]  // Types de véhicules favoris
  budgetMoyen           Decimal?        @db.Decimal(10, 2)
  transmissionPreferee  Transmission?
  carburantPrefere      Carburant?
  equipementsPreferes   String[]
  derniereMiseAJour     DateTime        @default(now())

  @@index([userId])
  @@map("user_preferences")
}
