/// **{{Feature}}Providers** - Providers Riverpod pour {{FEATURE_DESC}}
///
/// ## Providers Disponibles
/// - `{{feature}}ViewModelProvider`: Le ViewModel
/// - `{{feature}}StateProvider`: Le State (alias pour lisibilité)
/// - `{{feature}}EffectsProvider`: Le Stream d'Effects
///
/// ## Utilisation dans le Screen
/// ```dart
/// class {{Feature}}Screen extends ConsumerStatefulWidget {
///   @override
///   ConsumerState<{{Feature}}Screen> createState() => _{{Feature}}ScreenState();
/// }
///
/// class _{{Feature}}ScreenState extends ConsumerState<{{Feature}}Screen>
///     with EffectHandler {
///   @override
///   void initState() {
///     super.initState();
///     listenToEffects({{feature}}EffectsProvider);
///   }
///
///   @override
///   Widget build(BuildContext context) {
///     final state = ref.watch({{feature}}StateProvider);
///     // ...
///   }
/// }
/// ```

// ============================================================================
// VIEWMODEL
// ============================================================================

/// **{{Feature}}ViewModel Provider**
///
/// Provider du ViewModel pour {{FEATURE_DESC}}.
final {{feature}}ViewModelProvider = StateNotifierProvider<{{Feature}}ViewModel, ViewState<{{Feature}}>>((ref) {
  return {{Feature}}ViewModel(
    get{{Feature}}UseCase: ref.read(get{{Feature}}UseCaseProvider),
    // TODO: Injecter les autres UseCases
  );
});

// ============================================================================
// STATE (Alias pour lisibilité)
// ============================================================================

/// **{{Feature}}State Provider**
///
/// Alias du state du ViewModel pour une meilleure lisibilité.
///
/// Utilisation:
/// ```dart
/// final state = ref.watch({{feature}}StateProvider);
/// ```
final {{feature}}StateProvider = Provider<ViewState<{{Feature}}>>((ref) {
  return ref.watch({{feature}}ViewModelProvider);
});

// ============================================================================
// EFFECTS
// ============================================================================

/// **{{Feature}}Effects Provider**
///
/// Stream d'Effects émis par le ViewModel.
///
/// Utilisation avec EffectHandler:
/// ```dart
/// @override
/// void initState() {
///   super.initState();
///   listenToEffects({{feature}}EffectsProvider);
/// }
/// ```
final {{feature}}EffectsProvider = StreamProvider<ViewEffect>((ref) {
  final viewModel = ref.watch({{feature}}ViewModelProvider.notifier);
  return viewModel.effects;
});

