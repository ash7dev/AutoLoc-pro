  /// **Charger {{FEATURE_DESC}}**
  ///
  /// Appelé automatiquement dans `onInit()`.
  ///
  /// Transitions:
  /// - Initial → Loading → Success/Failure
  /// - Failure → Loading → Success/Failure (retry)
  @override
  Future<void> load() async {
    state = const ViewState.loading();

    final result = await get{{Feature}}UseCase();

    result.fold(
      (failure) => state = ViewState.failure(
        failure.message,
        code: failure.code,
      ),
      ({{feature}}) => state = ViewState.success({{feature}}),
    );
  }

