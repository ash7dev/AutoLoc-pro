  // TODO: Implémenter les autres méthodes du repository

  // =========================================================================
  // ERROR HANDLING
  // =========================================================================

  /// **Gérer les erreurs Dio**
  ///
  /// Convertit les DioException en Failures appropriés.
  FailureType _handleDioError(DioException error) {
    switch (error.type) {
      case DioExceptionType.connectionTimeout:
      case DioExceptionType.sendTimeout:
      case DioExceptionType.receiveTimeout:
        return NetworkFailure(
          message: 'Délai d\'attente dépassé. Vérifiez votre connexion.',
        );

      case DioExceptionType.badResponse:
        final statusCode = error.response?.statusCode;

        if (statusCode == 400) {
          return ValidationFailure(
            message: error.response?.data['message'] as String? ??
                'Requête invalide',
          );
        } else if (statusCode == 401) {
          return AuthFailure(
            message: 'Session expirée. Veuillez vous reconnecter.',
          );
        } else if (statusCode == 403) {
          return AuthFailure(
            message: 'Accès non autorisé',
          );
        } else if (statusCode == 404) {
          return NotFoundFailure(
            message: '{{Feature_DESC}} introuvable',
          );
        } else if (statusCode == 500) {
          return ServerFailure(
            message: 'Erreur serveur. Veuillez réessayer plus tard.',
          );
        } else {
          return ServerFailure(
            message: 'Erreur serveur (${statusCode ?? 'unknown'})',
          );
        }

      case DioExceptionType.cancel:
        return UnknownFailure(
          message: 'Requête annulée',
        );

      case DioExceptionType.connectionError:
        return NetworkFailure(
          message: 'Pas de connexion internet',
        );

      case DioExceptionType.badCertificate:
        return NetworkFailure(
          message: 'Erreur de certificat SSL',
        );

      case DioExceptionType.unknown:
      default:
        return UnknownFailure(
          message: 'Une erreur est survenue: ${error.message}',
          originalError: error.toString(),
        );
    }
  }
}
